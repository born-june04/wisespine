# WiseSpine Project Environment Configuration Template
# Copy this to .env and modify paths for your local setup

# Project root directory (absolute path)
WISESPINE_ROOT=/gscratch/scrubbed/june0604/wisespine

# Data directories
VERSE_DATA_DIR=/gscratch/scrubbed/june0604/wisespine/VerSe
OUTPUTS_DIR=/gscratch/scrubbed/june0604/wisespine/outputs
MESHES_DIR=/gscratch/scrubbed/june0604/wisespine/outputs/meshes

# Phase-specific output directories
PHASE3_OUTPUT_DIR=/gscratch/scrubbed/june0604/wisespine/outputs/phase3_physics_fracture
PHASE4_OUTPUT_DIR=/gscratch/scrubbed/june0604/wisespine/outputs/phase4_surgical_artifacts

# TotalSegmentator settings
TOTALSEG_EVAL_DIR=/gscratch/scrubbed/june0604/wisespine/totalseg_eval

# Default subject for testing
DEFAULT_SUBJECT=sub-verse563
DEFAULT_VERTEBRA=L1

# CT imaging parameters
